rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if requesting user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: check if the requesting user is a scoped single-court admin for
    // this specific venueId+courtId — independent of role/managedVenueIds
    // (ManageCourtsScreen's "Assign Admin" grants this without touching role).
    function isCourtAdminFor(venueId, courtId) {
      return request.auth != null &&
        (venueId + '::' + courtId) in
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.managedCourtIds;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if isOwner(userId);
      // skillLevel can only change via an admin-approved skill request
      // (SkillRequestService.approveRequest) — the owner can update every
      // other profile field (including pendingSkillLevel, walletBalance,
      // etc.) directly.
      allow update: if isAdmin() ||
                       (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['skillLevel']));
      allow delete: if false;
    }

    // ── Venues (public read, admin write) ────────────────────────────────────
    match /venues/{venueId} {
      allow read:   if true;
      allow write:  if isAdmin();
      // Submitting a review recomputes the venue's rating/reviewCount
      // (ReviewService._updateVenueRating) — allow any signed-in user to
      // update just those two fields, nothing else.
      allow update: if request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['rating', 'reviewCount']);

      // Courts subcollection
      match /courts/{courtId} {
        allow read:  if true;
        allow write: if isAdmin();

        // Slots (date doc → times subcollection)
        match /slots/{date}/times/{slotId} {
          allow read:   if request.auth != null;
          // Writes go through Firestore Transactions from BookingService / Cloud Functions
          allow write:  if request.auth != null;
        }
      }
    }

    // ── Bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read:   if request.auth != null &&
                       (resource.data.userId == request.auth.uid || isAdmin() ||
                        isCourtAdminFor(resource.data.venueId, resource.data.courtId));
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // ── Open Matches ─────────────────────────────────────────────────────────
    match /open_matches/{matchId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null &&
                       request.resource.data.organizerId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                       resource.data.organizerId == request.auth.uid;
    }

    // ── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── Notifications (written by admin actions, e.g. payment verification) ──
    match /notifications/{notificationId} {
      allow read:   if request.auth != null &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if request.auth != null &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow delete: if false;
    }

    // ── Tournaments (admin-created, players join via participantIds) ────────
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Joining only ever touches participantIds; anything broader is admin-only.
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']));
    }

    // ── Market (admin-created listings, any signed-in user can buy) ─────────
    match /market_items/{itemId} {
      allow read:   if request.auth != null;
      allow create: if isAdmin();
      // Buying and removing a listing both only ever flip `status`.
      allow update: if request.auth != null &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ── Skill level verification requests ────────────────────────────────────
    match /skill_requests/{requestId} {
      allow read:   if request.auth != null &&
                       (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
